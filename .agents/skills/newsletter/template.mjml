<mjml>
  <mj-head>

    <!-- ======================================================
         FONT
         Basier Circle via Fontshare. Falls back to system stack
         in email clients that don't support web fonts (e.g. Gmail,
         Outlook for Windows).
    ====================================================== -->
    <mj-font
      name="Basier Circle"
      href="https://api.fontshare.com/v2/css?f[]=basier-circle@400,500,600,700&display=swap"
    />

    <!-- ======================================================
         GLOBAL DEFAULTS
    ====================================================== -->
    <mj-attributes>
      <mj-all
        font-family="'Basier Circle', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif"
      />
      <mj-text
        font-size="16px"
        line-height="1.65"
        color="#43445B"
        padding="0px"
      />
      <mj-section padding="0px" />
      <mj-column padding="0px" />
      <mj-image padding="0px" />
      <mj-button
        font-size="14px"
        font-weight="600"
        background-color="#F6704D"
        color="#FFFFFF"
        border-radius="4px"
        inner-padding="12px 24px"
        letter-spacing="0.3px"
        text-decoration="none"
      />
    </mj-attributes>

    <mj-style>
      a { color: #F6704D; }
    </mj-style>

    <!-- Preview text (shown in inbox before opening) -->
    <mj-preview>What keeps communities together — and what tears them apart — tchop dispatch</mj-preview>

  </mj-head>

  <mj-body background-color="#F1F1F3">

    <!-- ============================================================
         [1] HEADER
         White background, 2px orange bottom border.
         IMPORTANT: Replace logo src with your actual hosted logo URL.
    ============================================================ -->
    <mj-section
      background-color="#FFFFFF"
      border-bottom="2px solid #F6704D"
    >
      <mj-column padding="20px 24px">
        <mj-image
          src="https://framerusercontent.com/images/m5l86q9XwaRLp7iXgJ4I6DyEqK8.svg?width=200&height=51"
          width="90px"
          align="left"
          alt="tchop.io"
          href="https://tchop.io"
        />
      </mj-column>
    </mj-section>

    <!-- ============================================================
         [2] INTRO
         Edition label, headline, body copy, sender signature.
         Decorative SVG accent above the label (three circles in
         brand colors). Replace with hosted PNG/SVG if needed.
    ============================================================ -->
    <mj-section background-color="#FFFFFF">
      <mj-column padding="40px 32px 36px">

        <!-- Decorative circles: Orange · Yellow · Blue -->
        <mj-image
          src="data:image/svg+xml;charset=utf-8,%3Csvg%20width%3D%2256%22%20height%3D%2220%22%20viewBox%3D%220%200%2056%2020%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Ccircle%20cx%3D%2210%22%20cy%3D%2210%22%20r%3D%2210%22%20fill%3D%22%23F6704D%22%2F%3E%3Ccircle%20cx%3D%2228%22%20cy%3D%2210%22%20r%3D%227%22%20fill%3D%22%23FFD138%22%2F%3E%3Ccircle%20cx%3D%2244%22%20cy%3D%2210%22%20r%3D%225%22%20fill%3D%22%23488ED8%22%20opacity%3D%220.7%22%2F%3E%3C%2Fsvg%3E"
          width="56px"
          align="left"
          alt=""
          padding="0px 0px 20px"
        />

        <!-- Edition label — e.g. "March 2026 · Issue #3" -->
        <mj-text
          font-size="11px"
          font-weight="700"
          letter-spacing="2px"
          text-transform="uppercase"
          color="#F6704D"
          padding="0px 0px 12px"
        >March 2026 · Issue #1</mj-text>

        <!-- Main intro headline -->
        <mj-text
          font-size="28px"
          font-weight="700"
          line-height="1.3"
          color="#2D2D46"
          padding="0px 0px 20px"
        >What keeps communities together — and what tears them apart</mj-text>

        <!-- Intro body — 2–4 short paragraphs, plain text or minimal HTML -->
        <mj-text
          font-size="16px"
          line-height="1.75"
          color="#43445B"
          padding="0px 0px 28px"
        ><p>Spring is here — and so is a fresh edition of the tchop dispatch, your monthly roundup of what's moving in community platforms, content strategy, and audience engagement.</p>
<p>This month we're looking at a topic that keeps coming up in conversations with our customers: how to keep a community alive once the initial excitement wears off. What makes people come back? And how does the right content infrastructure make or break long-term retention?</p>
<p>We've also pulled together our three most-read blog posts from February, plus a few product updates worth knowing about. Hit reply — we read every response.</p></mj-text>

        <mj-divider
          border-color="#F1F1F3"
          border-width="1px"
          padding="0px 0px 20px"
        />

        <!-- Sender signature -->
        <mj-text font-size="14px" color="#888888">
          <strong style="color: #2D2D46;">Heiko Scherer</strong><br />
          <a href="https://tchop.io" style="color: #F6704D; text-decoration: none;">tchop.io</a>
        </mj-text>

      </mj-column>
    </mj-section>

    <!-- Spacer -->
    <mj-section background-color="#F1F1F3">
      <mj-column padding="12px" />
    </mj-section>

    <!-- ============================================================
         [3] FEATURE SECTION
         One hero item (full width) + two items in a 2-column grid.
    ============================================================ -->

    <!-- Section label -->
    <mj-section background-color="#F1F1F3">
      <mj-column padding="0px 16px 12px">
        <mj-text padding="0px">
          <span style="display: inline-block; border-left: 3px solid #F6704D; padding-left: 10px; font-size: 11px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: #43445B;">Featured</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Feature Item 1 — Hero -->
    <mj-section background-color="#FFFFFF">
      <mj-column>
        <!-- Replace {{FEATURE_1_IMAGE}} with a 600px wide image URL -->
        <mj-image
          src="https://framerusercontent.com/images/YsMyfJY4l5ShsnRzD1NjMDQOhtM.png"
          alt="Smart community platform overview"
          fluid-on-mobile="true"
        />
        <mj-text
          font-size="11px"
          font-weight="700"
          letter-spacing="2px"
          text-transform="uppercase"
          color="#F6704D"
          padding="24px 32px 8px"
        >Platform Update</mj-text>
        <mj-text
          font-size="22px"
          font-weight="700"
          line-height="1.3"
          color="#2D2D46"
          padding="0px 32px 12px"
        >Introducing Smart Channels: less noise, more signal</mj-text>
        <mj-text
          font-size="15px"
          line-height="1.7"
          color="#43445B"
          padding="0px 32px 24px"
        >Content overload is the number one reason communities go quiet. Smart Channels automatically surfaces the content each member cares about — reducing churn and doubling session depth in early beta tests.</mj-text>
        <mj-button
          align="left"
          href="https://tchop.io/platform/features"
          padding="0px 32px 32px"
        >See what's new →</mj-button>
      </mj-column>
    </mj-section>

    <!-- Spacer -->
    <mj-section background-color="#F1F1F3">
      <mj-column padding="8px" />
    </mj-section>

    <!-- Feature Items 2 + 3 — 2-column grid -->
    <!-- Gap between cards is achieved via border="4px solid #F1F1F3" -->
    <mj-section background-color="#F1F1F3">

      <mj-column
        background-color="#FFFFFF"
        border="4px solid #F1F1F3"
        padding="0px"
        vertical-align="top"
      >
        <mj-image
          src="https://framerusercontent.com/images/qUsedgVBZ9bRS7JY4HMDZsAgmEs.png"
          alt="Question of the Month community feature"
          fluid-on-mobile="true"
          padding="0px"
        />
        <mj-text
          font-size="11px"
          font-weight="700"
          letter-spacing="2px"
          text-transform="uppercase"
          color="#F6704D"
          padding="16px 20px 8px"
        >Community</mj-text>
        <mj-text
          font-size="17px"
          font-weight="700"
          line-height="1.35"
          color="#2D2D46"
          padding="0px 20px 10px"
        >Question of the Month is now available on all plans</mj-text>
        <mj-text
          font-size="14px"
          line-height="1.65"
          color="#43445B"
          padding="0px 20px 16px"
        >Drive weekly engagement with a single interactive question. The most popular beta feature is now available on every plan — no add-on required.</mj-text>
        <mj-text font-size="14px" font-weight="600" padding="0px 20px 28px">
          <a href="https://tchop.io/platform/features" style="color: #F6704D; text-decoration: none;">Read more →</a>
        </mj-text>
      </mj-column>

      <mj-column
        background-color="#FFFFFF"
        border="4px solid #F1F1F3"
        padding="0px"
        vertical-align="top"
      >
        <mj-image
          src="https://framerusercontent.com/images/WMuj51wdUTyb4sDqSeSLB2IlC8.png"
          alt="Audio and podcast content in one channel"
          fluid-on-mobile="true"
          padding="0px"
        />
        <mj-text
          font-size="11px"
          font-weight="700"
          letter-spacing="2px"
          text-transform="uppercase"
          color="#F6704D"
          padding="16px 20px 8px"
        >Content</mj-text>
        <mj-text
          font-size="17px"
          font-weight="700"
          line-height="1.35"
          color="#2D2D46"
          padding="0px 20px 10px"
        >Audio posts, podcast feeds, and video — all in one channel</mj-text>
        <mj-text
          font-size="14px"
          line-height="1.65"
          color="#43445B"
          padding="0px 20px 16px"
        >Your audience shouldn't need a separate app for every format. tchop now supports audio posts alongside articles, videos, and discussions in any channel.</mj-text>
        <mj-text font-size="14px" font-weight="600" padding="0px 20px 28px">
          <a href="https://tchop.io/platform/features" style="color: #F6704D; text-decoration: none;">Read more →</a>
        </mj-text>
      </mj-column>

    </mj-section>

    <!-- Spacer -->
    <mj-section background-color="#F1F1F3">
      <mj-column padding="16px" />
    </mj-section>

    <!-- ============================================================
         [4] BLOG SECTION
         Links to blog.tchop.io. One hero item + two in a 2-col grid.
         Blue (#488ED8) is used for category tags to visually distinguish
         blog content from feature news.
    ============================================================ -->

    <!-- Section label -->
    <mj-section background-color="#F1F1F3">
      <mj-column padding="0px 16px 12px">
        <mj-text padding="0px">
          <span style="display: inline-block; border-left: 3px solid #FFD138; padding-left: 10px; font-size: 11px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: #43445B;">From the Blog</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Blog Item 1 — Full width, orange top border accent -->
    <mj-section
      background-color="#FFFFFF"
      border-top="3px solid #F6704D"
    >
      <mj-column padding="0px">
        <mj-image
          src="https://framerusercontent.com/images/sEMLK0oqu73lmxAvMJqa0uDcZI.png"
          alt="Workforce communication on tchop"
          fluid-on-mobile="true"
          padding="0px"
        />
        <mj-text
          font-size="11px"
          font-weight="700"
          letter-spacing="2px"
          text-transform="uppercase"
          color="#488ED8"
          padding="20px 32px 8px"
        >Strategy</mj-text>
        <mj-text
          font-size="20px"
          font-weight="700"
          line-height="1.35"
          color="#2D2D46"
          padding="0px 32px 12px"
        >Why your community stops growing after month three — and what to do about it</mj-text>
        <mj-text
          font-size="15px"
          line-height="1.7"
          color="#43445B"
          padding="0px 32px 16px"
        >Every community builder knows the early buzz. The real challenge starts when novelty wears off. We looked at what separates communities that keep growing from those that plateau.</mj-text>
        <mj-text font-size="14px" font-weight="600" padding="0px 32px 28px">
          <a href="https://blog.tchop.io/community-growth-plateau" style="color: #F6704D; text-decoration: none;">Read on the blog →</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Spacer -->
    <mj-section background-color="#F1F1F3">
      <mj-column padding="8px" />
    </mj-section>

    <!-- Blog Items 2 + 3 — 2-column grid -->
    <mj-section background-color="#F1F1F3">

      <mj-column
        background-color="#FFFFFF"
        border="4px solid #F1F1F3"
        padding="0px"
        vertical-align="top"
      >
        <mj-image
          src="https://framerusercontent.com/images/Q2XNXpEdNDJyLRNvoMUao5tqPc.png?width=600&height=420"
          alt="Content calendar and planning on tchop"
          height="210"
          padding="0px"
        />
        <mj-text
          font-size="11px"
          font-weight="700"
          letter-spacing="2px"
          text-transform="uppercase"
          color="#488ED8"
          padding="16px 20px 8px"
        >Guides</mj-text>
        <mj-text
          font-size="16px"
          font-weight="700"
          line-height="1.35"
          color="#2D2D46"
          padding="0px 20px 10px"
        >The content calendar template we use internally</mj-text>
        <mj-text
          font-size="14px"
          line-height="1.65"
          color="#43445B"
          padding="0px 20px 16px"
        >A simple, repeatable structure for planning weekly content — built around formats that consistently drive engagement in member apps.</mj-text>
        <mj-text font-size="14px" font-weight="600" padding="0px 20px 28px">
          <a href="https://blog.tchop.io/content-calendar-template" style="color: #F6704D; text-decoration: none;">Read more →</a>
        </mj-text>
      </mj-column>

      <mj-column
        background-color="#FFFFFF"
        border="4px solid #F1F1F3"
        padding="0px"
        vertical-align="top"
      >
        <mj-image
          src="https://framerusercontent.com/images/eAQX4s1Y7kGQOIvzkwjQZjsksMk.png?width=600&height=420"
          alt="Community hub Mixes view on tchop"
          height="210"
          padding="0px"
        />
        <mj-text
          font-size="11px"
          font-weight="700"
          letter-spacing="2px"
          text-transform="uppercase"
          color="#488ED8"
          padding="16px 20px 8px"
        >Case Study</mj-text>
        <mj-text
          font-size="16px"
          font-weight="700"
          line-height="1.35"
          color="#2D2D46"
          padding="0px 20px 10px"
        >How AOK built a branded employee app in 6 weeks</mj-text>
        <mj-text
          font-size="14px"
          line-height="1.65"
          color="#43445B"
          padding="0px 20px 16px"
        >A step-by-step look at how one of Germany's largest health insurers launched a fully branded internal community — from kickoff to launch.</mj-text>
        <mj-text font-size="14px" font-weight="600" padding="0px 20px 28px">
          <a href="https://blog.tchop.io/aok-case-study" style="color: #F6704D; text-decoration: none;">Read more →</a>
        </mj-text>
      </mj-column>

    </mj-section>

    <!-- Spacer -->
    <mj-section background-color="#F1F1F3">
      <mj-column padding="16px" />
    </mj-section>

    <!-- ============================================================
         [5] RECOMMENDED READS
         Curated external links — title + description only, no images.
         Blue accent (#488ED8) to distinguish from Featured (orange)
         and Blog (yellow).
    ============================================================ -->

    <!-- Section label -->
    <mj-section background-color="#F1F1F3">
      <mj-column padding="0px 16px 12px">
        <mj-text padding="0px">
          <span style="display: inline-block; border-left: 3px solid #488ED8; padding-left: 10px; font-size: 11px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: #43445B;">Recommended Reads</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Reads list -->
    <mj-section background-color="#FFFFFF">
      <mj-column padding="28px 32px">

        <!-- Read 1 -->
        <mj-text
          font-size="17px"
          font-weight="700"
          line-height="1.35"
          color="#2D2D46"
          padding="0px 0px 6px"
        ><a href="https://example.com/read-1" style="color: #2D2D46; text-decoration: none;">Why async-first teams outperform always-on cultures</a></mj-text>
        <mj-text
          font-size="14px"
          line-height="1.65"
          color="#43445B"
          padding="0px 0px 20px"
        >A growing body of research shows that structured async communication reduces burnout and improves decision quality. This piece breaks down the evidence.</mj-text>

        <mj-divider border-color="#F1F1F3" border-width="1px" padding="0px 0px 20px" />

        <!-- Read 2 -->
        <mj-text
          font-size="17px"
          font-weight="700"
          line-height="1.35"
          color="#2D2D46"
          padding="0px 0px 6px"
        ><a href="https://example.com/read-2" style="color: #2D2D46; text-decoration: none;">The membership economy is eating media — here's what's next</a></mj-text>
        <mj-text
          font-size="14px"
          line-height="1.65"
          color="#43445B"
          padding="0px 0px 20px"
        >Subscriptions alone won't save publishers. The next wave combines paid access with community features and exclusive content formats.</mj-text>

        <mj-divider border-color="#F1F1F3" border-width="1px" padding="0px 0px 20px" />

        <!-- Read 3 -->
        <mj-text
          font-size="17px"
          font-weight="700"
          line-height="1.35"
          color="#2D2D46"
          padding="0px 0px 6px"
        ><a href="https://example.com/read-3" style="color: #2D2D46; text-decoration: none;">What employee apps can learn from consumer social products</a></mj-text>
        <mj-text
          font-size="14px"
          line-height="1.65"
          color="#43445B"
          padding="0px 0px 0px"
        >Enterprise tools don't have to feel like enterprise tools. A product designer explains how consumer UX patterns translate to internal platforms.</mj-text>

      </mj-column>
    </mj-section>

    <!-- Spacer -->
    <mj-section background-color="#F1F1F3">
      <mj-column padding="16px" />
    </mj-section>

    <!-- ============================================================
         [6] PRODUCT CTA
         Full-bleed orange. White text. White button with orange text.
         This section is optional — hide or delete it in Loops if not
         needed for a given edition.
    ============================================================ -->
    <mj-section background-color="#F6704D">
      <mj-column padding="40px 32px">

        <!-- Decorative concentric circles in yellow -->
        <mj-image
          src="data:image/svg+xml;charset=utf-8,%3Csvg%20width%3D%2240%22%20height%3D%2240%22%20viewBox%3D%220%200%2040%2040%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Ccircle%20cx%3D%2220%22%20cy%3D%2220%22%20r%3D%2220%22%20fill%3D%22%23FFD138%22%20opacity%3D%220.2%22%2F%3E%3Ccircle%20cx%3D%2220%22%20cy%3D%2220%22%20r%3D%2213%22%20fill%3D%22%23FFD138%22%20opacity%3D%220.35%22%2F%3E%3Ccircle%20cx%3D%2220%22%20cy%3D%2220%22%20r%3D%226%22%20fill%3D%22%23FFD138%22%2F%3E%3C%2Fsvg%3E"
          width="40px"
          align="left"
          alt=""
          padding="0px 0px 20px"
        />

        <mj-text
          font-size="24px"
          font-weight="700"
          line-height="1.3"
          color="#FFFFFF"
          padding="0px 0px 12px"
        >Ready to build a community your audience actually uses?</mj-text>

        <mj-text
          font-size="16px"
          line-height="1.65"
          color="#FFFFFF"
          padding="0px 0px 28px"
        >tchop gives media publishers, associations, and enterprise teams the platform to go beyond the newsletter — with branded apps, smart content channels, and real engagement data.</mj-text>

        <mj-button
          href="https://tchop.io/company/contact"
          background-color="#FFFFFF"
          color="#F6704D"
          font-weight="700"
          align="left"
          padding="0px"
        >Book a demo →</mj-button>

      </mj-column>
    </mj-section>

    <!-- ============================================================
         [6] FOOTER
         Dark indigo. Logo (white variant), nav links, social icons,
         legal text, Loops unsubscribe/preferences merge tags.
         IMPORTANT: Replace logo src with your actual white logo URL.
    ============================================================ -->
    <mj-section background-color="#2D2D46">
      <mj-column padding="36px 32px 32px">

        <!-- White logo variant — paste your hosted white logo URL here, or upload via Loops media library -->
        <mj-image
          src="https://framerusercontent.com/images/m5l86q9XwaRLp7iXgJ4I6DyEqK8.svg?width=200&height=51"
          width="80px"
          align="left"
          alt="tchop.io"
          href="https://tchop.io"
          padding="0px 0px 24px"
        />

        <!-- Nav links -->
        <mj-text
          font-size="13px"
          color="#AAAAAA"
          padding="0px 0px 20px"
        >
          <a href="https://tchop.io" style="color: #FFFFFF; text-decoration: none;">tchop.io</a>
          &nbsp;&middot;&nbsp;
          <a href="https://tchop.io/platform/features" style="color: #FFFFFF; text-decoration: none;">Platform</a>
          &nbsp;&middot;&nbsp;
          <a href="https://tchop.io/resources/library" style="color: #FFFFFF; text-decoration: none;">Resources</a>
          &nbsp;&middot;&nbsp;
          <a href="https://blog.tchop.io" style="color: #FFFFFF; text-decoration: none;">Blog</a>
        </mj-text>

        <mj-divider
          border-color="#43445B"
          border-width="1px"
          padding="0px 0px 20px"
        />

        <!-- Social icons — orange brand color -->
        <mj-social
          align="left"
          icon-size="20px"
          padding="0px 0px 24px"
        >
          <mj-social-element
            name="linkedin"
            href="https://www.linkedin.com/company/tchop-io"
            background-color="#F6704D"
          >LinkedIn</mj-social-element>
          <mj-social-element
            name="twitter"
            href="https://twitter.com/tchop_io"
            background-color="#F6704D"
          >Twitter / X</mj-social-element>
        </mj-social>

        <!-- Legal + unsubscribe -->
        <!-- Loops merge tags: {unsubscribe_link} and {preferences_link} -->
        <mj-text
          font-size="12px"
          color="#666666"
          line-height="1.7"
        >
          You're receiving this because you subscribed at
          <a href="https://tchop.io" style="color: #888888;">tchop.io</a>.<br />
          tchop GmbH &middot; Berlin, Germany<br /><br />
          <a href="{unsubscribe_link}" style="color: #888888; text-decoration: underline;">Unsubscribe</a>
          &nbsp;&middot;&nbsp;
          <a href="{preferences_link}" style="color: #888888; text-decoration: underline;">Manage preferences</a>
        </mj-text>

      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
